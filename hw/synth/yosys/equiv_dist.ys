#
# Formal equivalence: distance RTL vs its synthesized gate netlist.
#
# The gold side keeps the two decoder instances; the gate side is flattened.
# equiv_make compares them over all 2^32 input pairs.

# gold: RTL reference, two decoders and the subtractors, flattened to match
# the flattened gate netlist
read_verilog -sv ../../rtl/tagma_decoder.v ../../rtl/tagma_dist.v
proc
flatten
opt
rename tagma_dist gold_dist

# gate: synthesized netlist from synth_dist_gates.ys
read_verilog -sv out/tagma_dist_gates.v
proc
opt
rename tagma_dist gate_dist

equiv_make gold_dist gate_dist equiv_dist
equiv_simple -seq 4 equiv_dist
equiv_induct -seq 4 equiv_dist
equiv_status -assert equiv_dist
