#
# Formal equivalence: compose RTL vs its synthesized gate netlist.
#
# Proves that out/tagma_compose_gates.v is logically identical to the RTL over
# all 2^15 axis combinations, valid and invalid alike.

# gold: RTL reference
read_verilog -sv ../../rtl/tagma_compose.v
proc
opt
rename tagma_compose gold_compose

# gate: synthesized netlist from synth_compose_gates.ys
read_verilog -sv out/tagma_compose_gates.v
proc
opt
rename tagma_compose gate_compose

equiv_make gold_compose gate_compose equiv_compose
equiv_simple -seq 4 equiv_compose
equiv_induct -seq 4 equiv_compose
equiv_status -assert equiv_compose
