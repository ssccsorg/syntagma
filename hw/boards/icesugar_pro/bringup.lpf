#
# iCESugar-Pro v1.3 (ECP5 LFE5U-25F-6BG256C) bring-up constraints.
#
# Pin names are ECP5 balls. The clock and the RGB LED sites follow the official
# blink demo in wuxx/icesugar-pro (src/blink/blink.lpf).
#
#   clk    -> P6,  25 MHz crystal, LVCMOS33
#   led_r  -> A11, RGB LED, LVCMOS25
#   led_g  -> A12, RGB LED, LVCMOS25
#   led_b  -> B11, RGB LED, LVCMOS25

LOCATE COMP "clk" SITE "P6";
IOBUF PORT "clk" IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk" 25 MHZ;

LOCATE COMP "led_r" SITE "A11";
IOBUF PORT "led_r" IO_TYPE=LVCMOS25;

LOCATE COMP "led_g" SITE "A12";
IOBUF PORT "led_g" IO_TYPE=LVCMOS25;

LOCATE COMP "led_b" SITE "B11";
IOBUF PORT "led_b" IO_TYPE=LVCMOS25;
