#
# iCESugar-Pro v1.3 constraints for the volume verification top.
#
# The iCELink carries four pins to four ECP5 balls. The host drives three of
# them and turns the stage into a colour, and reads the fourth for the verdict,
# because the firmware keeps that one as an input to the host.
#
#   clk_in     -> P6,  25 MHz crystal, LVCMOS33
#   stage[0]   -> F5,  iCELink PA14, LVCMOS33, driven by the host
#   stage[1]   -> N4,  iCELink PA0,  LVCMOS33, driven by the host
#   stage[2]   -> J5,  iCELink PA1,  LVCMOS33, driven by the host
#   pin_match  -> H5,  iCELink PA13, LVCMOS33, read by the host
#   led_green  -> A11, bank 1, LVCMOS25, RGB LED green channel, active high
#   led_blue   -> A12, bank 1, LVCMOS25, RGB LED blue channel, active high
#   led_red    -> B11, bank 1, LVCMOS25, RGB LED red channel, active high

LOCATE COMP "clk_in" SITE "P6";
IOBUF PORT "clk_in" IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk_in" 25 MHZ;

LOCATE COMP "stage[0]" SITE "F5";
IOBUF PORT "stage[0]" IO_TYPE=LVCMOS33;

LOCATE COMP "stage[1]" SITE "N4";
IOBUF PORT "stage[1]" IO_TYPE=LVCMOS33;

LOCATE COMP "stage[2]" SITE "J5";
IOBUF PORT "stage[2]" IO_TYPE=LVCMOS33;

LOCATE COMP "pin_match" SITE "H5";
IOBUF PORT "pin_match" IO_TYPE=LVCMOS33;

LOCATE COMP "led_green" SITE "A11";
IOBUF PORT "led_green" IO_TYPE=LVCMOS25;

LOCATE COMP "led_blue" SITE "A12";
IOBUF PORT "led_blue" IO_TYPE=LVCMOS25;

LOCATE COMP "led_red" SITE "B11";
IOBUF PORT "led_red" IO_TYPE=LVCMOS25;
