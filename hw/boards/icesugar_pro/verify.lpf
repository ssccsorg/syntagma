#
# iCESugar-Pro v1.3 constraints for the on-device verification top.
#
# The three outputs land on the ECP5 balls that the on-board iCELink reaches as
# GPIOs, so the host reads the verdict with icesprog and no external wiring is
# involved. The ball to iCELink pin mapping is the JTAG2 set from the vendor
# README, repurposed here as a plain data path.
#
#   clk_in    -> P6,  25 MHz crystal, LVCMOS33
#   pin_match -> F5,  iCELink PA14, LVCMOS33
#   pin_beat  -> H5,  iCELink PA13, LVCMOS33
#   pin_sweep -> N4,  iCELink PA0,  LVCMOS33

LOCATE COMP "clk_in" SITE "P6";
IOBUF PORT "clk_in" IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk_in" 25 MHZ;

LOCATE COMP "pin_match" SITE "F5";
IOBUF PORT "pin_match" IO_TYPE=LVCMOS33;

LOCATE COMP "pin_beat" SITE "H5";
IOBUF PORT "pin_beat" IO_TYPE=LVCMOS33;

LOCATE COMP "pin_sweep" SITE "N4";
IOBUF PORT "pin_sweep" IO_TYPE=LVCMOS33;
